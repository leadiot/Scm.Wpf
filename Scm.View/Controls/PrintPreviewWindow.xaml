<Window x:Class="Com.Scm.Controls.PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="打印预览"
        Width="1000" Height="760"
        MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Top"
                Padding="8"
                Background="{StaticResource ScmPanelBackground}"
                BorderBrush="{StaticResource ScmBorderBrush}"
                BorderThickness="0 0 0 1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="打印" Width="88" Margin="0 0 8 0"
                        Style="{StaticResource ButtonPrimary}"
                        Click="BtPrint_Click"/>
                <Button Content="关闭" Width="88" Click="BtClose_Click"/>
            </StackPanel>
        </Border>
        <FlowDocumentReader x:Name="Viewer"
                            Margin="8"
                            ViewingMode="Page"
                            IsPageViewEnabled="True"
                            IsTwoPageViewEnabled="False"
                            IsScrollViewEnabled="False"
                            IsFindEnabled="False"
                            IsPrintEnabled="False"/>
    </DockPanel>
</Window>
